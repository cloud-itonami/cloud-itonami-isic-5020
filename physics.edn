;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:dev:physics` runs it.
;;
;; README "Robotics premise": an autonomous tanker-loading / valve robot
;; performs the physical cargo handling of a tanker (ISIC 5020) -- loading,
;; inerting and discharging the cargo tanks and turning the manifold
;; valves. Here: the line velocity the robot sets by opening the loading
;; valve (static electricity limits it), and the pressure the cargo pumps
;; must hold at the shore manifold when discharging cargoes of different
;; viscosity.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isic-5020"
 :cases
 [{:id :loading-line-velocity
   :kind :pipe-flow
   :procedure "the valve robot opens the loading line (300 mm, 150 m from the ship's manifold to the tank) to the loading rate; the rate is swept"
   :params {:diameter-m 0.30 :length-m 150.0 :roughness-m 4.5e-5
            :density-kg-m3 860.0 :viscosity-pa-s 0.008 :pump-efficiency 0.75 :elevation-m 0.0}
   :sweep {:param :q-m3s :values [0.05 0.10 0.20 0.30 0.40 0.50]}
   :quantity :velocity-mps
   :limit {:max 7.0 :basis "estimate: the bulk-loading line-velocity cap used for static-accumulator cargoes in tanker safety guidance (ISGOTT); confirm the edition and section before citing it as a source"}
   :boundary {:lo 0.01 :hi 1.0}}
  {:id :discharge-shore-manifold-pressure
   :kind :pipe-flow
   :procedure "cargo pumps discharge 720 m3/h through 400 m of 250 mm line to the shore tank 15 m above; cargoes from light crude to cold heavy fuel oil are swept by viscosity"
   :params {:q-m3s 0.20 :diameter-m 0.25 :length-m 400.0 :roughness-m 4.5e-5
            :density-kg-m3 950.0 :pump-efficiency 0.70 :elevation-m 15.0}
   :sweep {:param :viscosity-pa-s :values [0.005 0.05 0.2 0.5 1.0 2.0]}
   :quantity :pressure-drop-pa
   :limit {:max 1.0e6 :basis "estimate: ~10 bar maximum pressure the terminal accepts at the shore manifold; cargo densities and viscosities are estimates too"}
   :boundary {:lo 0.001 :hi 3.0}}]}
